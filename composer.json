{
    "name": "ngandu-dev/flexpay",
    "description": "FlexPay API PHP Client",
    "keywords": [
        "flexpay",
        "mobile money",
        "payment gateway",
        "api"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/ngandu-dev/flexpay-php",
    "autoload": {
        "psr-4": {
            "Ngandu\\Flexpay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ngandu\\Flexpay\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "bernard-ng",
            "email": "bernard@ngandu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/ngandu-dev/flexpay-php/issues",
        "source": "https://github.com/ngandu-dev/flexpay-php"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "symfony/http-client": "^7.0|^8.0",
        "webmozart/assert": "^1.11|^2.4",
        "symfony/serializer": "^7.0|^8.0",
        "symfony/property-access": "^7.0|^8.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.0|^8.0",
        "rector/rector": "^2.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symplify/easy-coding-standard": "^13.0"
    },
    "scripts": {
        "format": ["php vendor/bin/ecs check --fix --ansi", "php vendor/bin/rector process --ansi"],
        "lint": ["php vendor/bin/ecs check --ansi", "php vendor/bin/rector process --dry-run --ansi"],
        "typecheck": "php vendor/bin/phpstan analyse --ansi",
        "test": "php vendor/bin/phpunit --colors=always",
        "quality": ["@lint", "@typecheck", "@test"]
    }
}
